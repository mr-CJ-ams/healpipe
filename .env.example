DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/healpipe
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
TARGET_ENDPOINT_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
HEALPIPE_PROCESS_ROLE=all
DELIVERY_WORKER_COUNT=2
WORKER_POLL_INTERVAL_SECONDS=5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
ALERT_FROM_EMAIL=alerts@example.com
ALERT_TO_EMAIL=operations@example.com
HEALPIPE_DASHBOARD_URL=http://localhost:5173
OPERATOR_API_KEY=
ACCOUNT_AUTH_REQUIRED=true
DELIVERY_RETRY_BACKOFF_SECONDS=0,60,300,1800,7200
AUDIT_EXPORT_MAX_ROWS=5000
REQUIRE_IDEMPOTENCY_KEY=true
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://127.0.0.1:8000
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_SECONDS=28800